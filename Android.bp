android_app {
    name: "AxWallpaperEffects",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    platform_apis: true,
    privileged: true,
    certificate: "platform",
    system_ext_specific: true,
    min_sdk_version: "36",
    required: [
        "privapp-permissions-axwallpapereffects",
    ],
    static_libs: [
        "ax_utils",
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "WeatherEffectsGraphicsLib",
        "axquicklook-client",
        "androidx.graphics_graphics-shapes",
        "tensorflowlite_java",
        "tflite_support_java",
        "tensorflow-lite-gpu",
        "tensorflow-lite-gpu-api",
        "toruslib",
    ],
    jni_libs: [
        "libtensorflowlite_jni",
        "libtensorflowlite_gpu_jni",
    ],
    // Carried inside the APK: an adb-installed update (persistent app, staged) otherwise has no
    // native libraries, because the system copy's libs are only symlinks under /system_ext.
    use_embedded_native_libs: true,
    aaptflags: [
        "-0 .tflite",
    ],
    optimize: {
        enabled: false,
    },
}

prebuilt_etc {
    name: "privapp-permissions-axwallpapereffects",
    system_ext_specific: true,
    src: "privapp-permissions-axwallpapereffects.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
